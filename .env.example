# Copy to .env and fill in ONE of these. Leave both empty to keep the mockup (nothing is sent).

# Option 1 — email each request to you. Get a free access key at https://web3forms.com
# (the key is tied to your email address and is safe to ship in the browser bundle).
VITE_WEB3FORMS_KEY=

# Option 2 — POST each request as JSON to your own URL
# (e.g. a Google Apps Script web app that appends to a Sheet, or a serverless function).
VITE_BOOKING_ENDPOINT=
